<div class="fd-tiles">
  <% overview.tiles.each do |tile| %>
    <div class="fd-card fd-tile">
      <div class="lbl"><%= tile.label %></div>
      <div class="val">
        <%= tile.value %><%
          %><% if tile.unit %><small><%= tile.unit %></small><% end %>
      </div>
      <div class="delta <%= fd_delta_class(tile) %>">
        <%= fd_trend_glyph(tile.trend) %> <%= tile.detail %>
      </div>
    </div>
  <% end %>
</div>
